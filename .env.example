APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VSPHERE_URL=
VSPHERE_USERNAME=
VSPHERE_PASSWORD=

ANTHROPIC_API_KEY=

GUEST_SSH_USERNAME=
GUEST_SSH_PASSWORD=
GUEST_SSH_PORT=22

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

TELEGRAM_DAILY_REPORT_BOT_TOKEN=
TELEGRAM_DAILY_REPORT_CHAT_ID=

# Set once the server room temperature/humidity sensor is installed — the
# device sends this back as X-Sensor-Token on every POST to
# /api/environment/readings. Leave blank until then; ingestion is rejected
# entirely while unset.
ENVIRONMENT_SENSOR_TOKEN=

# Fallback account for VMs where GUEST_SSH_* root login is rejected — most
# of this network's Linux fleet, per GuestSshService/SshSuEscalation. Logs
# in as this regular account, then "su -" to root using
# SSH_FALLBACK_SU_PASSWORD. One shared account across the network.
SSH_FALLBACK_USERNAME=
SSH_FALLBACK_PASSWORD=
SSH_FALLBACK_SU_PASSWORD=

# Master off-switch for the scheduled commands that SSH into the whole VM
# fleet every few minutes (smart-detection:scan, services:check). Set to
# false on a dev machine running Herd's per-site scheduler so it stops
# logging into every host; leave true/unset in production. The Services
# and Smart Detection pages still work — they just show last-known data
# with a manual "Refresh".
FLEET_SSH_SCANS_ENABLED=true
